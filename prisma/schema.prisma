// ============================================================================
// Huellitas Pet Shop — e-commerce schema (mockup)
// ----------------------------------------------------------------------------
// Provider: SQLite for the local/client demo (zero setup, runs anywhere).
// Production target: PostgreSQL. This schema deliberately avoids
// SQLite-specific types so the switch is configuration + small tweaks:
//
//   - enums        -> PostgreSQL enums (unchanged)
//   - String JSON  -> Json  (ProductVariant.attributes, Product.tags)
//   - Float money  -> Decimal(10, 2) (recommended for production)
//   - DateTime     -> add @db.Timestamptz on PostgreSQL
//
// Design notes (see D:/ecommerce/proto/guia-del-proyecto.md):
//   - UUID primary keys, soft-deleted entities via isActive flags
//   - Multi-store ready: ALL stock lives in StockByLocation (location + product)
//   - Order items snapshot product name/price at purchase time
//   - StockMovements is an immutable audit trail of inventory changes
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum LocationType {
  STORE
  WAREHOUSE
  BOTH
}

enum StockMovementType {
  RECEIPT
  SALE
  ADJUSTMENT
  TRANSFER
  RESERVATION
  RELEASE
  RETURN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  MERCADOPAGO
  CASH
  TRANSFER
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

enum SubscriptionFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum NotificationType {
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  STOCK_ALERT
  PAYMENT
  PROMO
  SYSTEM
}

// ---------------------------------------------------------------------------
// Locations — one store today, multi-store ready (stock is per location)
// ---------------------------------------------------------------------------

model Location {
  id           String   @id @default(uuid())
  name         String
  type         LocationType @default(STORE)
  isActive     Boolean  @default(true)
  servesOnline Boolean  @default(true)
  addressLine1 String?
  addressLine2 String?
  city         String?
  province     String?
  postalCode   String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stock     StockByLocation[]
  movements StockMovement[]
  orders    Order[]
  orderItems OrderItem[]
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String    @id @default(uuid())
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]
}

model Product {
  id             String   @id @default(uuid())
  sku            String   @unique
  name           String
  slug           String   @unique
  description    String?
  // Money as Float for the SQLite demo; production uses Decimal(10, 2).
  price          Float
  compareAtPrice Float?
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  weightGrams    Int?
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  // JSON array as text for SQLite compatibility; production uses Json.
  tags           String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  images        ProductImage[]
  variants      ProductVariant[]
  stock         StockByLocation[]
  movements     StockMovement[]
  orderItems    OrderItem[]
  subscriptions Subscription[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

model ProductVariant {
  id         String  @id @default(uuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  sku        String  @unique
  name       String
  price      Float
  // JSON object as text for SQLite compatibility; production uses Json.
  attributes String  @default("{}")
  imageUrl   String?
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  images       ProductImage[]
  stock        StockByLocation[]
  movements    StockMovement[]
  orderItems   OrderItem[]
  subscriptions Subscription[]

  @@index([productId])
}

model ProductImage {
  id        String         @id @default(uuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  url       String
  altText   String?
  sortOrder Int            @default(0)
  isPrimary Boolean        @default(false)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Inventory — multi-store ready
// ---------------------------------------------------------------------------

model StockByLocation {
  id                String   @id @default(uuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  variantId         String?
  variant           ProductVariant? @relation(fields: [variantId], references: [id])
  locationId        String
  location          Location @relation(fields: [locationId], references: [id])
  quantityAvailable Int      @default(0)
  quantityReserved  Int      @default(0)
  reorderThreshold  Int      @default(5)
  updatedAt         DateTime @updatedAt

  @@unique([productId, variantId, locationId])
  @@index([locationId])
}

model StockMovement {
  id         String            @id @default(uuid())
  productId  String
  product    Product           @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant?   @relation(fields: [variantId], references: [id])
  locationId String
  location   Location          @relation(fields: [locationId], references: [id])
  quantity   Int               // positive = in, negative = out
  type       StockMovementType
  reason     String?
  referenceId String?          // e.g. order id, receipt id
  createdAt  DateTime          @default(now())

  @@index([productId, locationId])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  phone        String?
  dni          String?
  passwordHash String?   // null in the mockup: auth is out of scope for the demo
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses     CustomerAddress[]
  orders        Order[]
  subscriptions Subscription[]

  @@index([isActive])
}

model CustomerAddress {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  label       String
  street      String
  streetNumber String
  city        String
  province    String
  postalCode  String
  isDefault   Boolean  @default(false)

  orders Order[] @relation("ShippingAddressOrders")

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Orders — line items snapshot name/price at purchase time
// ---------------------------------------------------------------------------

model Order {
  id                String        @id @default(uuid())
  // Human-friendly sequential number. SQLite only allows autoincrement() on
  // the id column; the repository assigns it (max+1). PostgreSQL can use
  // @default(autoincrement()) directly — no schema change needed there.
  orderNumber       Int           @unique
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id])
  status            OrderStatus   @default(PENDING)
  subtotal          Float
  shippingCost      Float         @default(0)
  discountAmount    Float         @default(0)
  taxAmount         Float         @default(0)
  total             Float
  assignedLocationId String?
  assignedLocation  Location?     @relation(fields: [assignedLocationId], references: [id])
  shippingAddressId String?
  shippingAddress   CustomerAddress? @relation("ShippingAddressOrders", fields: [shippingAddressId], references: [id])
  carrier           String?
  trackingNumber    String?
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  invoiceType       String?       // Factura: "B" | "C" | null
  invoiceNumber     String?
  invoiceCae        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items OrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  // Snapshots (catalog changes must not alter historical orders)
  productName String
  variantName String?

  @@index([orderId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Subscriptions (recurring pet food) — MercadoPago preapproval in production
// ---------------------------------------------------------------------------

model Subscription {
  id                       String                @id @default(uuid())
  customerId               String
  customer                 Customer              @relation(fields: [customerId], references: [id])
  productId                String
  product                  Product               @relation(fields: [productId], references: [id])
  variantId                String?
  variant                  ProductVariant?       @relation(fields: [variantId], references: [id])
  quantity                 Int                   @default(1)
  frequency                SubscriptionFrequency
  pricePerDelivery         Float
  status                   SubscriptionStatus    @default(ACTIVE)
  nextDeliveryDate         DateTime?
  mercadopagoPreapprovalId String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  @@index([customerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Coupons & notifications
// ---------------------------------------------------------------------------

model Coupon {
  id                 String     @id @default(uuid())
  code               String     @unique
  type               CouponType
  value              Float      // % (PERCENTAGE), amount (FIXED_AMOUNT) or shipping amount (FREE_SHIPPING)
  minimumOrderAmount Float?
  maximumUses        Int?
  currentUses        Int        @default(0)
  startsAt           DateTime?
  expiresAt          DateTime?
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
}

model Notification {
  id            String           @id @default(uuid())
  type          NotificationType
  title         String
  message       String
  referenceType String?
  referenceId   String?
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())

  @@index([isRead])
  @@index([type])
}