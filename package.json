{
  "name": "universopet-mockup",
  "version": "0.1.0",
  "private": true,
  "description": "E-commerce mockup for a pet shop (modular monolith with a reusable core). Next.js 15 + TypeScript + Prisma + Tailwind.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
