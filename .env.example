# ---------------------------------------------------------------------------
# Universo Pet — mockup environment variables
# Copy this file to .env and fill in real values when integrating providers.
# ---------------------------------------------------------------------------

# Database — SQLite for the local/client demo (zero setup).
# Production: PostgreSQL (Railway), e.g. postgresql://user:pass@host:5432/db
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Integrations (STUBBED in this mockup — see src/services/*)
# ---------------------------------------------------------------------------

# MercadoPago — access token used to create payment preferences / preapprovals.
MERCADOPAGO_ACCESS_TOKEN=

# AFIP / ARCA — electronic invoice (CAE) integration. Certificates go in files,
# not in env; these are the identifiers.
AFIP_CUIT=
AFIP_CERT=
AFIP_PRIVATE_KEY=

# Resend — transactional email (order confirmations, invoices).
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Public (safe to expose to the browser, prefixed NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# WhatsApp number in international format without "+" (E.164).
NEXT_PUBLIC_WHATSAPP_NUMBER=5491122334455